# Tailscale features left out of the card app's build (tailscale.com/feature/buildfeatures: ts_omit_<name>),
# read by build.sh and licenses.sh. The Q2 runs a userspace node that only reaches the tailnet: what it
# never does here is compiled out, for a smaller binary (its code is read from the card into RAM) and
# fewer goroutines. tsnet itself needs serve and acme, so they stay. A line is a tag; # starts a comment.
ts_omit_logtail            # no log upload to Tailscale's servers, no log buffers on the card
ts_omit_netlog
ts_omit_clientupdate       # the app is updated from Q2 Pod's App Store
ts_omit_webclient          # no local web UI
ts_omit_webbrowser
ts_omit_ssh                # the Q2 serves nothing to the tailnet
ts_omit_drive
ts_omit_relayserver
ts_omit_advertiseexitnode
ts_omit_advertiseroutes
ts_omit_appconnectors
ts_omit_wakeonlan
ts_omit_portlist
ts_omit_capture
ts_omit_posture
ts_omit_tpm                # hardware and platforms the Q2 isn't
ts_omit_aws
ts_omit_cloud
ts_omit_kube
ts_omit_synology
ts_omit_flashappliance
ts_omit_androidbin
ts_omit_androiddns
ts_omit_bird
ts_omit_systray
ts_omit_desktop_sessions
ts_omit_tap
ts_omit_dbus               # no D-Bus, systemd, NetworkManager, resolved or syslog to talk to
ts_omit_sdnotify
ts_omit_networkmanager
ts_omit_resolved
ts_omit_syslog
ts_omit_iptables           # userspace networking: no kernel routes or firewall
ts_omit_linuxdnsfight
ts_omit_tundevstats
ts_omit_oauthkey           # signed in with the QR code, not keys
ts_omit_identityfederation
ts_omit_outboundproxy
ts_omit_remoteconfig
ts_omit_c2n
ts_omit_doctor             # CLI and debugging tools
ts_omit_completion
ts_omit_completion_scripts
ts_omit_debugeventbus
ts_omit_debugportmapper
ts_omit_qrcodes            # the app draws its own (internal/qr)
ts_omit_ace
